# Database Configuration
DATABASE_URL=postgresql://estudohub_admin:estudohub_pass@db:5432/estudohub
POSTGRES_USER=estudohub_admin
POSTGRES_PASSWORD=estudohub_pass
POSTGRES_DB=estudohub

# Backend
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000

# LLM Configuration
USE_LOCAL_LLM=true
LLM_STRATEGY=local_first
CLOUD_FALLBACK=true
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_MODEL_CHEAP=llama3.2:1b
OLLAMA_TIMEOUT=600

# Optional Cloud LLM API Keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Clerk Authentication
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional Admins
ADMIN_USER_IDS=

# Storage
STORAGE_K_PATH=./storage_k
